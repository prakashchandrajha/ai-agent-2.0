ENTROPY_THRESHOLD=0.85
MIN_CONFIDENCE_TO_STORE=0.80
MIN_CONTEXTS_TO_PASS=4
SANDBOX_TIMEOUT=30
MAX_LEARNING_ITERATIONS=3