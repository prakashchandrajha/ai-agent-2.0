LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=phi3:medium
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
DATA_DIR=./data
CHROMADB_PATH=./data/chromadb
