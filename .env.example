# ── LLM Backend ──────────────────────────────────────────────
# Options: ollama, lmstudio, openai
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
DEFAULT_MODEL=qwen2.5:3b

# ── Embedding ────────────────────────────────────────────────
# Options: ollama, local
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Data Paths ───────────────────────────────────────────────
DATA_DIR=./data
CHROMA_PATH=./data/chromadb
EKU_STORE_PATH=./data/eku_store
SANDBOX_PATH=/tmp/agent_sandbox
LOGS_PATH=./data/logs

# ── Learning Parameters ──────────────────────────────────────
MAX_SOURCES=5
ENTROPY_THRESHOLD=0.92
MIN_CONFIDENCE_TO_STORE=0.80
MIN_CONTEXTS_TO_PASS=4
SANDBOX_TIMEOUT=30
MAX_LEARNING_ITERATIONS=10

# ── Stress Testing ───────────────────────────────────────────
ADVERSARIAL_TESTS_PER_EKU=5
WORST_CASE_SCENARIOS=3
